{
  "name": "payment-service",
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "version": "1.0.0",
  "private": true,
  "description": "Account microservice",
  "scripts": {
    "build": "nest build && cp -r src/prisma/generated dist/prisma/",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config ./tests/jest-e2e.json"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.9.13",
    "@grpc/proto-loader": "^0.7.10",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/microservices": "^10.3.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.0",
    "@one-recycle/shared": "file:../shared",
    "@prisma/client": "^5.5.2",
    "@types/passport-jwt": "^4.0.1",
    "axios": "^1.12.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.19.19",
    "@types/supertest": "^6.0.0",
    "jest": "^29.5.0",
    "prisma": "^5.5.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "ts-proto": "^2.7.7",
    "tsconfig-paths": "^4.1.0",
    "typescript": "^5.1.3"
  }
}
