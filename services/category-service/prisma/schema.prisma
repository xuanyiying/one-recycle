datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

model Category {
    id          Int      @id @default(autoincrement())
    name        String
    description String?
    type        String   @default("PRODUCT")
    parentId    Int?     @map("parent_id")
    icon        String?
    priceInfo   String   @map("price_info")
    seo         String
    sortOrder   Int      @default(0) @map("sort_order")
    isVisible   Boolean  @default(true) @map("is_visible")
    isFeatured  Boolean  @default(false) @map("is_featured")
    attributes  String?
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")

    // 自引用关系
    parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
    children Category[] @relation("CategoryHierarchy")

    @@map("categories")
}

/// 物品分类
model ItemCategory {
  id           BigInt         @id @default(autoincrement())
  name         String         @db.VarChar(50)
  parentId     BigInt?        @map("parent_id")
  enabled      Boolean        @default(true)
  iconUrl      String?        @map("icon_url") @db.VarChar(255)
  createdAt    DateTime       @default(now()) @map("created_at")
  parent       ItemCategory?  @relation("SubCategories", fields: [parentId], references: [id])
  children     ItemCategory[] @relation("SubCategories")
  pricingRules PricingRule[]

  @@map("item_categories")
}

/// 计价规则
model PricingRule {
  id             BigInt       @id @default(autoincrement())
  categoryId     BigInt       @map("category_id")
  regionCode     String?      @map("region_code") @db.VarChar(20)
  basePricePerKg Decimal      @map("base_price_per_kg") @db.Decimal(10, 2)
  weightTiers    Json?        @map("weight_tiers") // e.g., [{min: 5, price: 4.8}, {min: 10, price: 4.5}]
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  category       ItemCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("pricing_rules")
}