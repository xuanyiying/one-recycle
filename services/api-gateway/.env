# API Gateway Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_COUNT=100

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Service URLs (根据共享常量 HTTP_PORTS 配置)
ACCOUNT_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004
COURIER_SERVICE_URL=http://localhost:3005
NOTIFICATION_SERVICE_URL=http://localhost:3006
CATEGORY_SERVICE_URL=http://localhost:3007
INVENTORY_SERVICE_URL=http://localhost:3008
DISPATCH_SERVICE_URL=http://localhost:3009
MESSAGE_QUEUE_URL=http://localhost:3010