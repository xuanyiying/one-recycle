datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

// 仓库表
model Warehouse {
  id           BigInt          @id @default(autoincrement())
  name         String          @db.VarChar(100)
  code         String          @unique @db.VarChar(20) // 仓库编码
  type         WarehouseType   @default(MAIN) // 仓库类型
  address      String          @db.VarChar(500)
  contactName  String?         @map("contact_name") @db.VarChar(50)
  contactPhone String?         @map("contact_phone") @db.VarChar(20)
  capacity     Decimal?        @db.Decimal(10, 2) // 仓库容量(立方米)
  status       WarehouseStatus @default(ACTIVE)
  description  String?         @db.VarChar(500)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  // 关联
  inventoryItems InventoryItem[]
  movements      InventoryMovement[]

  @@index([type, status])
  @@map("warehouses")
}

// 商品分类表
model ItemCategory {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(50)
  code        String   @unique @db.VarChar(20) // 分类编码
  parentId    BigInt?  @map("parent_id")
  level       Int      @default(1) // 分类层级
  enabled     Boolean  @default(true)
  iconUrl     String?  @map("icon_url") @db.VarChar(255)
  description String?  @db.VarChar(500)
  sortOrder   Int      @default(0) @map("sort_order") // 排序
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // 自关联
  parent   ItemCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ItemCategory[] @relation("CategoryHierarchy")

  // 关联
  inventoryItems InventoryItem[]
  movements      InventoryMovement[]
  pricingRules   PricingRule[]

  @@index([parentId])
  @@index([enabled, level])
  @@map("item_categories")
}

model InventoryItem {
  id               BigInt           @id @default(autoincrement())
  warehouseId      BigInt           @map("warehouse_id")
  categoryId       BigInt           @map("category_id")
  name             String           @db.VarChar(100)
  description      String?          @db.VarChar(500)
  unit             String           @db.VarChar(20) // 单位，如 kg, 件, 个等
  quantity         Decimal          @db.Decimal(12, 2) // 库存数量
  reservedQty      Decimal          @default(0) @map("reserved_qty") @db.Decimal(12, 2) // 预留数量
  availableQty     Decimal          @default(0) @map("available_qty") @db.Decimal(12, 2) // 可用数量
  unitPrice        Decimal          @map("unit_price") @db.Decimal(10, 2) // 单价
  totalPrice       Decimal          @map("total_price") @db.Decimal(12, 2) // 总价值
  location         String?          @db.VarChar(100) // 存放位置
  status           InventoryStatus  @default(IN_STOCK)
  itemType         ItemType         @default(RECYCLED) @map("item_type") // 商品类型
  condition        ItemCondition    @default(GOOD) // 商品状态
  sourceOrderId    String?          @map("source_order_id") @db.VarChar(50) // 来源订单ID
  qualityGrade     String?          @map("quality_grade") @db.VarChar(20) // 质量等级
  processingStatus ProcessingStatus @default(RECEIVED) @map("processing_status") // 处理状态
  expiryDate       DateTime?        @map("expiry_date") // 过期时间（如适用）
  batchNumber      String?          @map("batch_number") @db.VarChar(50) // 批次号
  minStockLevel    Decimal?         @map("min_stock_level") @db.Decimal(12, 2) // 最低库存预警
  maxStockLevel    Decimal?         @map("max_stock_level") @db.Decimal(12, 2) // 最高库存预警
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // 关联
  warehouse     Warehouse              @relation(fields: [warehouseId], references: [id])
  category      ItemCategory           @relation(fields: [categoryId], references: [id])
  transactions  InventoryTransaction[]
  salesRecords  SalesRecord[]
  qualityChecks QualityCheck[]
  movements     InventoryMovement[]
  reservations  Reservation[]

  @@index([warehouseId, categoryId, status])
  @@index([sourceOrderId])
  @@map("inventory_items")
}

model InventoryTransaction {
  id          BigInt          @id @default(autoincrement())
  itemId      BigInt          @map("item_id")
  type        TransactionType
  quantity    Decimal         @db.Decimal(12, 2) // 变动数量
  unitPrice   Decimal         @map("unit_price") @db.Decimal(10, 2) // 单价
  totalPrice  Decimal         @map("total_price") @db.Decimal(12, 2) // 总价值
  referenceId String?         @map("reference_id") @db.VarChar(50) // 关联订单ID等
  notes       String?         @db.VarChar(500)
  createdAt   DateTime        @default(now()) @map("created_at")
  item        InventoryItem   @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@map("inventory_transactions")
}

model SalesRecord {
  id         BigInt        @id @default(autoincrement())
  itemId     BigInt        @map("item_id")
  quantity   Decimal       @db.Decimal(12, 2)
  unitPrice  Decimal       @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal       @map("total_price") @db.Decimal(12, 2)
  orderId    String        @map("order_id") @db.VarChar(50)
  customerId BigInt        @map("customer_id")
  soldAt     DateTime      @map("sold_at")
  notes      String?       @db.VarChar(500)
  createdAt  DateTime      @default(now()) @map("created_at")
  item       InventoryItem @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([orderId])
  @@map("sales_records")
}

model QualityCheck {
  id        BigInt        @id @default(autoincrement())
  itemId    BigInt        @map("item_id")
  checkerId BigInt        @map("checker_id") // 检查员ID
  checkType CheckType     @map("check_type")
  result    CheckResult
  score     Int? // 质量评分 (1-100)
  notes     String?       @db.VarChar(1000)
  images    String[] // 检查照片URLs
  checkedAt DateTime      @map("checked_at")
  createdAt DateTime      @default(now()) @map("created_at")
  item      InventoryItem @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([checkerId])
  @@map("quality_checks")
}

enum InventoryStatus {
  IN_STOCK // 在库
  LOW_STOCK // 库存不足
  OUT_OF_STOCK // 缺货
}

enum TransactionType {
  INBOUND // 入库
  OUTBOUND // 出库
  ADJUSTMENT // 调整
  TRANSFER_OUT // 调拨出库
  TRANSFER_IN // 调拨入库
}

enum ItemType {
  RECYCLED // 回收商品
  PURCHASED // 采购商品
  RETURNED // 退货商品
}

enum ItemCondition {
  EXCELLENT // 优秀
  GOOD // 良好
  FAIR // 一般
  POOR // 较差
  DAMAGED // 损坏
}

enum ProcessingStatus {
  RECEIVED // 已接收
  INSPECTING // 检查中
  PROCESSING // 处理中
  CLEANED // 已清洁
  REPAIRED // 已维修
  READY // 准备就绪
  REJECTED // 已拒收
}

enum CheckType {
  INITIAL // 初检
  DETAILED // 详检
  FINAL // 终检
  RANDOM // 抽检
}

enum CheckResult {
  PASSED // 通过
  FAILED // 不通过
  CONDITIONAL // 有条件通过
}

// 新增枚举定义
enum WarehouseType {
  MAIN // 主仓库
  BRANCH // 分仓库
  TRANSIT // 中转仓
  RETURN // 退货仓
}

enum WarehouseStatus {
  ACTIVE // 启用
  INACTIVE // 停用
  MAINTENANCE // 维护中
}

// 库存预订表
model Reservation {
  id          BigInt            @id @default(autoincrement())
  itemId      BigInt            @map("item_id")
  orderId     String            @map("order_id") @db.VarChar(50)
  quantity    Decimal           @db.Decimal(12, 2)
  status      ReservationStatus @default(PENDING)
  reservedAt  DateTime          @default(now()) @map("reserved_at")
  expiresAt   DateTime?         @map("expires_at")
  confirmedAt DateTime?         @map("confirmed_at")
  cancelledAt DateTime?         @map("cancelled_at")
  notes       String?           @db.VarChar(500)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  // 关联
  item InventoryItem @relation(fields: [itemId], references: [id])

  @@index([itemId, status])
  @@index([orderId])
  @@index([status, expiresAt])
  @@map("reservations")
}

// 库存变动记录表
model InventoryMovement {
  id            BigInt            @id @default(autoincrement())
  itemId        BigInt            @map("item_id")
  warehouseId   BigInt            @map("warehouse_id")
  categoryId    BigInt            @map("category_id")
  movementType  MovementType      @map("movement_type")
  direction     MovementDirection // 入库/出库
  quantity      Decimal           @db.Decimal(12, 2) // 变动数量
  unitPrice     Decimal?          @map("unit_price") @db.Decimal(10, 2) // 单价
  totalAmount   Decimal?          @map("total_amount") @db.Decimal(12, 2) // 总金额
  beforeQty     Decimal           @map("before_qty") @db.Decimal(12, 2) // 变动前数量
  afterQty      Decimal           @map("after_qty") @db.Decimal(12, 2) // 变动后数量
  referenceType String?           @map("reference_type") @db.VarChar(50) // 关联单据类型
  referenceId   BigInt?           @map("reference_id") // 关联单据ID
  referenceNo   String?           @map("reference_no") @db.VarChar(50) // 关联单据号
  operatorId    BigInt?           @map("operator_id") // 操作人ID
  operatorName  String?           @map("operator_name") @db.VarChar(50) // 操作人姓名
  remark        String?           @db.VarChar(500) // 备注
  createdAt     DateTime          @default(now()) @map("created_at")

  // 关联
  item      InventoryItem @relation(fields: [itemId], references: [id])
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id])
  category  ItemCategory  @relation(fields: [categoryId], references: [id])

  @@index([itemId, createdAt])
  @@index([warehouseId, movementType])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("inventory_movements")
}

// 定价规则表
model PricingRule {
  id             BigInt    @id @default(autoincrement())
  categoryId     BigInt    @map("category_id")
  regionCode     String?   @map("region_code") @db.VarChar(20) // 地区编码
  priceType      PriceType @map("price_type") // 定价类型
  basePrice      Decimal   @map("base_price") @db.Decimal(10, 2) // 基础价格
  unit           String    @default("kg") @db.VarChar(10) // 计价单位
  weightTiers    Json?     @map("weight_tiers") // 重量阶梯定价
  qualityFactors Json?     @map("quality_factors") // 品质系数
  seasonFactors  Json?     @map("season_factors") // 季节系数
  enabled        Boolean   @default(true)
  validFrom      DateTime  @map("valid_from") // 生效时间
  validTo        DateTime? @map("valid_to") // 失效时间
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // 关联
  category ItemCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId, enabled])
  @@index([validFrom, validTo])
  @@map("pricing_rules")
}

// 库存预警记录表
model InventoryAlert {
  id            BigInt      @id @default(autoincrement())
  itemId        BigInt      @map("item_id")
  alertType     AlertType   @map("alert_type")
  alertLevel    AlertLevel  @map("alert_level")
  currentQty    Decimal     @map("current_qty") @db.Decimal(12, 2)
  thresholdQty  Decimal     @map("threshold_qty") @db.Decimal(12, 2)
  message       String      @db.VarChar(500)
  status        AlertStatus @default(PENDING)
  handledBy     BigInt?     @map("handled_by") // 处理人ID
  handledAt     DateTime?   @map("handled_at")
  handlerRemark String?     @map("handler_remark") @db.VarChar(500)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([status, alertLevel])
  @@index([createdAt])
  @@map("inventory_alerts")
}

enum MovementType {
  PURCHASE // 采购入库
  RECYCLE_IN // 回收入库
  SALE_OUT // 销售出库
  TRANSFER_IN // 调拨入库
  TRANSFER_OUT // 调拨出库
  ADJUST_IN // 盘盈
  ADJUST_OUT // 盘亏
  DAMAGE_OUT // 报损出库
  RETURN_IN // 退货入库
  RETURN_OUT // 退货出库
}

enum MovementDirection {
  IN // 入库
  OUT // 出库
}

enum PriceType {
  RECYCLE // 回收价格
  SALE // 销售价格
  WHOLESALE // 批发价格
}

enum AlertType {
  LOW_STOCK // 低库存
  HIGH_STOCK // 高库存
  EXPIRY // 即将过期
  ZERO_STOCK // 零库存
}

enum AlertLevel {
  INFO // 信息
  WARNING // 警告
  CRITICAL // 严重
}

enum AlertStatus {
  PENDING // 待处理
  HANDLED // 已处理
  IGNORED // 已忽略
}

enum ReservationStatus {
  PENDING // 待确认
  CONFIRMED // 已确认
  EXPIRED // 已过期
  CANCELLED // 已取消
}
