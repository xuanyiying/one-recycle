{
  "name": "account-service",
  "version": "1.0.0",
  "description": "Account management microservice for One Recycle platform",
  "author": "One Recycle Team",
  "private": true,
  "license": "UNLICENSED",
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  },
  "scripts": {
    "build": "nest build && mkdir -p dist/src/proto && cp src/proto/* dist/src/proto/",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./tests/jest-e2e.json",
    "test:integration": "jest --config ./tests/jest-integration.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "proto:generate": "protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/proto --ts_proto_opt=nestJs=true --proto_path=./src/proto ./src/proto/*.proto"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.9.13",
    "@grpc/proto-loader": "0.7.10",
    "@nestjs/common": "11.1.8",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.8",
    "@nestjs/mapped-types": "2.1.0",
    "@nestjs/microservices": "11.1.8",
    "@nestjs/platform-express": "11.1.8",
    "@one-recycle/shared": "file:../shared",
    "@prisma/client": "6.17.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.8",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.8.1",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-prettier": "5.0.0",
    "jest": "30.2.0",
    "prettier": "3.0.0",
    "prisma": "6.17.1",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "ts-proto": "2.7.7",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/../tests/setup.ts"
    ],
    "setupFiles": [
      "<rootDir>/../tests/setup.ts"
    ],
    "moduleNameMapper": {
      "^@shared/(.*)$": "<rootDir>/../../shared/src/$1",
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
