{
  "name": "courier-service",
  "version": "1.0.0",
  "description": "Courier microservice for One Recycle platform",
  "author": "One Recycle Team",
  "private": true,
  "license": "UNLICENSED",
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate --schema=./src/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./src/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=./src/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=./src/prisma/schema.prisma",
    "proto:generate": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/proto --ts_proto_opt=env=node,useOptionals=messages,outputServices=grpc-js ./src/proto/*.proto"
  },
  "dependencies": {
    "@nestjs/common": "11.1.8",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.8",
    "@nestjs/microservices": "11.1.8",
    "@nestjs/platform-express": "11.1.8",
    "@one-recycle/shared": "file:../shared",
    "@prisma/client": "6.17.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.8",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.8.1",
    "@types/supertest": "6.0.3",
    "prettier": "3.0.0",
    "prisma": "6.17.1",
    "axios": "1.12.2",
    "jest": "30.2.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "typescript": "5.7.2"
  }
}
