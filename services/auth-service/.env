# 服务器配置
PORT=3002
GRPC_PORT=50052
NODE_ENV=development
API_VERSION=1.0.0

# 微服务配置
ACCOUNT_SERVICE_URL=http://localhost:3002

# 数据库配置
DATABASE_URL="postgresql://user:password@localhost:5432/account_db"

# JWT配置
JWT_SECRET=dev-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=dev-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Redis配置
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# 短信服务配置
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=dev-access-key-id
SMS_ACCESS_KEY_SECRET=dev-access-key-secret
SMS_SIGN_NAME=dev-sign-name
SMS_TEMPLATE_CODE=dev-template-code

# 微信小程序配置
WECHAT_APP_ID=dev-wechat-app-id
WECHAT_APP_SECRET=dev-wechat-app-secret

# 支付宝小程序配置
ALIPAY_APP_ID=dev-alipay-app-id
ALIPAY_APP_SECRET=dev-alipay-app-secret
ALIPAY_PRIVATE_KEY=dev-alipay-private-key
ALIPAY_PUBLIC_KEY=dev-alipay-public-key

# 抖音小程序配置
DOUYIN_APP_ID=dev-douyin-app-id
DOUYIN_APP_SECRET=dev-douyin-app-secret

# 快手小程序配置
KUAISHOU_APP_ID=dev-kuaishou-app-id
KUAISHOU_APP_SECRET=dev-kuaishou-app-secret

# 文件上传配置
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp

# 日志配置
LOG_LEVEL=debug
LOG_FILE_PATH=logs/app.log

# 限流配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS配置
CORS_ORIGIN=http://localhost:3000,http://localhost:3001