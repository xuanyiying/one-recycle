# 测试环境配置
NODE_ENV=test
PORT=3002
GRPC_PORT=50052

# 数据库配置（测试用PostgreSQL数据库）
DATABASE_URL="postgresql://user:password@localhost:5432/account_db_test"

# JWT配置
JWT_SECRET=test-jwt-secret-key-for-testing
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=test-jwt-refresh-secret-key-for-testing
JWT_REFRESH_EXPIRES_IN=7d

# Redis配置（测试用）
REDIS_URL=redis://localhost:6380

# 第三方平台配置（测试用模拟值）
WECHAT_APP_ID=test-wechat-app-id
WECHAT_APP_SECRET=test-wechat-app-secret
WECHAT_REDIRECT_URI=http://localhost:3001/auth/wechat/callback

ALIPAY_APP_ID=test-alipay-app-id
ALIPAY_APP_SECRET=test-alipay-app-secret
ALIPAY_REDIRECT_URI=http://localhost:3001/auth/alipay/callback

DOUYIN_APP_ID=test-douyin-app-id
DOUYIN_APP_SECRET=test-douyin-app-secret
DOUYIN_REDIRECT_URI=http://localhost:3001/auth/douyin/callback

KUAISHOU_APP_ID=test-kuaishou-app-id
KUAISHOU_APP_SECRET=test-kuaishou-app-secret
KUAISHOU_REDIRECT_URI=http://localhost:3001/auth/kuaishou/callback

# 短信服务配置（测试用）
SMS_PROVIDER=mock
SMS_ACCESS_KEY_ID=test-access-key-id
SMS_ACCESS_KEY_SECRET=test-access-key-secret
SMS_SIGN_NAME=测试签名
SMS_TEMPLATE_CODE=SMS_TEST_001

# 日志配置
LOG_LEVEL=error
LOG_FILE_PATH=tests/logs/test.log

# 限流配置（测试用更宽松的限制）
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000