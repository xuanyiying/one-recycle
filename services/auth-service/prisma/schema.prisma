generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 用户主表
model User {
  id              BigInt           @id @default(autoincrement())
  mobile          String?          @unique @db.VarChar(20)
  nickname        String?          @db.VarChar(50)
  avatarUrl       String?          @map("avatar_url") @db.VarChar(255)
  status          UserStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  identities      UserIdentity[]
  addresses       Address[]
  orders          Order[]
  invoiceRequests InvoiceRequest[]

  @@map("users")
}

/// 用户多平台身份
model UserIdentity {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  provider  String   @db.VarChar(20) // 'wechat', 'alipay', 'douyin'
  appId     String   @map("app_id") @db.VarChar(100)
  openid    String   @db.VarChar(100)
  unionid   String?  @db.VarChar(100)
  extraData Json?    @map("extra_data")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@unique([provider, openid])
  @@index([userId])
  @@map("user_identities")
}

/// 用户地址
model Address {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  consignee String   @db.VarChar(50)
  mobile    String   @db.VarChar(20)
  province  String   @db.VarChar(50)
  city      String   @db.VarChar(50)
  district  String   @db.VarChar(50)
  detail    String   @db.VarChar(255)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])
  orders    Order[]

  @@index([userId])
  @@map("addresses")
}

/// 物品分类
model ItemCategory {
  id           BigInt         @id @default(autoincrement())
  name         String         @db.VarChar(50)
  parentId     BigInt?        @map("parent_id")
  enabled      Boolean        @default(true)
  iconUrl      String?        @map("icon_url") @db.VarChar(255)
  createdAt    DateTime       @default(now()) @map("created_at")
  parent       ItemCategory?  @relation("SubCategories", fields: [parentId], references: [id])
  children     ItemCategory[] @relation("SubCategories")
  orderItems   OrderItem[]
  pricingRules PricingRule[]

  @@map("item_categories")
}

/// 计价规则
model PricingRule {
  id             BigInt       @id @default(autoincrement())
  categoryId     BigInt       @map("category_id")
  regionCode     String?      @map("region_code") @db.VarChar(20)
  basePricePerKg Decimal      @map("base_price_per_kg") @db.Decimal(10, 2)
  weightTiers    Json?        @map("weight_tiers") // e.g., [{min: 5, price: 4.8}, {min: 10, price: 4.5}]
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  category       ItemCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("pricing_rules")
}

/// 订单
model Order {
  id               BigInt       @id @default(autoincrement())
  orderNo          String       @unique @map("order_no") @db.VarChar(40)
  userId           BigInt       @map("user_id")
  addressId        BigInt       @map("address_id")
  status           OrderStatus  @default(PENDING)
  expectPickupTime DateTime     @map("expect_pickup_time")
  actualPickupTime DateTime?    @map("actual_pickup_time")
  estimatedAmount  Decimal      @default(0) @map("estimated_amount") @db.Decimal(10, 2)
  settlementAmount Decimal      @default(0) @map("settlement_amount") @db.Decimal(10, 2)
  payAmount        Decimal      @default(0) @map("pay_amount") @db.Decimal(10, 2)
  channel          String       @db.VarChar(30) // 'WECHAT_MP', 'ALIPAY_MP'
  remark           String?      @db.VarChar(500)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  user             User         @relation(fields: [userId], references: [id])
  address          Address      @relation(fields: [addressId], references: [id])
  items            OrderItem[]
  assignments      Assignment[]
  payments         Payment[]

  @@index([userId, status, createdAt])
  @@map("orders")
}

/// 订单物品明细
model OrderItem {
  id              BigInt       @id @default(autoincrement())
  orderId         BigInt       @map("order_id")
  categoryId      BigInt       @map("category_id")
  estimatedWeight Decimal?     @map("estimated_weight") @db.Decimal(10, 2)
  actualWeight    Decimal?     @map("actual_weight") @db.Decimal(10, 2)
  unitPrice       Decimal      @map("unit_price") @db.Decimal(10, 2)
  amount          Decimal      @db.Decimal(10, 2)
  createdAt       DateTime     @default(now()) @map("created_at")
  order           Order        @relation(fields: [orderId], references: [id])
  category        ItemCategory @relation(fields: [categoryId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

/// 快递员
model Courier {
  id          BigInt        @id @default(autoincrement())
  name        String        @db.VarChar(50)
  mobile      String        @unique @db.VarChar(20)
  status      CourierStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  assignments Assignment[]

  @@map("couriers")
}

/// 派单记录
model Assignment {
  id         BigInt           @id @default(autoincrement())
  orderId    BigInt           @map("order_id")
  courierId  BigInt           @map("courier_id")
  status     AssignmentStatus @default(ASSIGNED)
  acceptedAt DateTime?        @map("accepted_at")
  arrivedAt  DateTime?        @map("arrived_at")
  finishedAt DateTime?        @map("finished_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  order      Order            @relation(fields: [orderId], references: [id])
  courier    Courier          @relation(fields: [courierId], references: [id])

  @@index([orderId])
  @@index([courierId, status])
  @@map("assignments")
}

/// 支付记录
model Payment {
  id            BigInt          @id @default(autoincrement())
  orderId       BigInt          @map("order_id")
  provider      PaymentProvider @map("provider")
  outTradeNo    String          @unique @map("out_trade_no") @db.VarChar(128)
  transactionId String?         @map("transaction_id") @db.VarChar(128)
  total         Decimal         @db.Decimal(10, 2)
  status        PaymentStatus   @default(PENDING)
  notifyRaw     Json?           @map("notify_raw")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  order         Order           @relation(fields: [orderId], references: [id])
  refunds       Refund[]

  @@index([orderId])
  @@map("payments")
}

/// 退款记录
model Refund {
  id           BigInt       @id @default(autoincrement())
  paymentId    BigInt       @map("payment_id")
  outRefundNo  String       @unique @map("out_refund_no") @db.VarChar(128)
  refundAmount Decimal      @map("refund_amount") @db.Decimal(10, 2)
  status       RefundStatus @default(PROCESSING)
  reason       String?      @db.VarChar(255)
  notifyRaw    Json?        @map("notify_raw")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  payment      Payment      @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

/// 发票申请
model InvoiceRequest {
  id        BigInt               @id @default(autoincrement())
  userId    BigInt               @map("user_id")
  title     String               @db.VarChar(100)
  taxNo     String               @map("tax_no") @db.VarChar(50)
  email     String               @db.VarChar(100)
  amount    Decimal              @db.Decimal(10, 2)
  status    InvoiceRequestStatus @default(PENDING)
  createdAt DateTime             @default(now()) @map("created_at")
  user      User                 @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("invoice_requests")
}

// --- Enums ---

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum OrderStatus {
  PENDING // 待派单
  ASSIGNED // 待接单
  ACCEPTED // 待上门
  PROCESSING // 回收中
  COMPLETED // 已完成
  CANCELLED // 已取消
}

enum CourierStatus {
  ACTIVE
  INACTIVE
  OFF_DUTY
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  REJECTED
  ARRIVED
  FINISHED
  CANCELLED
}

enum PaymentProvider {
  WECHAT
  ALIPAY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CLOSED
}

enum RefundStatus {
  PROCESSING
  SUCCESS
  FAILED
}

enum InvoiceRequestStatus {
  PENDING
  COMPLETED
  FAILED
}
