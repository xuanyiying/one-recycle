{
  "name": "@one-recycle/api",
  "version": "1.0.0",
  "description": "One Recycle API Specifications and Types",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest tests/integration",
    "test:unit": "jest tests/auth tests/user --testPathIgnorePatterns=integration",
    "test:auth": "jest tests/auth",
    "test:user": "jest tests/user",
    "test:simple": "jest tests/simple.test.ts",
    "test:coverage-report": "node scripts/test-coverage.js",
    "generate:types": "openapi-typescript specs/openapi/v1/*.yaml --output types/generated/",
    "generate:docs": "redoc-cli build specs/openapi/v1/index.yaml --output docs/api.html"
  },
  "keywords": [
    "api",
    "typescript",
    "openapi",
    "microservices",
    "one-recycle"
  ],
  "author": "One Recycle Team",
  "license": "MIT",
  "dependencies": {
    "@nestjs/common": "11.1.8",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.8",
    "@nestjs/jwt": "11.0.1",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.8",
    "@nestjs/swagger": "11.2.1",
    "@nestjs/throttler": "6.4.0",
    "@one-recycle/shared": "file:../shared",
    "@prisma/client": "6.17.1",
    "axios": "1.12.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.0",
    "helmet": "8.1.0",
    "lodash": "4.17.21",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.8",
    "@types/jest": "30.0.0",
    "@types/node": "24.8.1",
    "@types/passport": "1.0.17",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/supertest": "6.0.3",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-prettier": "5.0.0",
    "jest": "30.2.0",
    "openapi-typescript": "6.0.0",
    "prettier": "3.0.0",
    "prisma": "6.17.1",
    "redoc-cli": "0.13.0",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.2"
  },
  "files": [
    "dist",
    "specs",
    "types"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
