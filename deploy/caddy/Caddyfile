# OneRecycle Caddy v2 配置
# 覆盖三域名：backbuy.cn / www.backbuy.cn / admin.backbuy.cn

{
	admin 127.0.0.1:2019
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

(access_log_json) {
	log {
		output file /data/access.log {
			roll_size 20MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}

# 主站 + /api 反向代理
backbuy.cn {
	import security_headers
	import access_log_json

	@api path /api /api/*
	handle @api {
		reverse_proxy api-gateway:3002
	}

	root * /var/www/html
	handle {
		try_files {path} {path}/ /index.html
		file_server
	}
}

api.backbuy.cn {
	import security_headers
	import access_log_json

	@withApi path /api /api/*
	handle @withApi {
		reverse_proxy api-gateway:3002
	}

	handle {
		redir https://backbuy.cn/api{uri} permanent
	}
}

# www 统一跳转到主域
www.backbuy.cn {
	import security_headers
	import access_log_json
	redir https://backbuy.cn{uri} permanent
}

# Admin 后台
admin.backbuy.cn {
	import security_headers
	import access_log_json
	reverse_proxy admin-web:3000
}
