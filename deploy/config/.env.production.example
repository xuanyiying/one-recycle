# Database Configuration
DB_USERNAME=one_recycle
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=one_recycle

# Redis Configuration
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# Application Secrets
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET_WITH_SPECIAL_CHARACTERS
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_EXPIRES_IN_SECONDS=7200

# External Services (Optional)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_APP_PUBLIC_CERT_PATH=
ALIPAY_ALIPAY_PUBLIC_CERT_PATH=
ALIPAY_ALIPAY_ROOT_CERT_PATH=

# AI Services (Optional)
OPENAI_API_KEY=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
ALIYUN_API_KEY=
ALIYUN_API_SECRET=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# SSL Certificate Configuration (Required for Let's Encrypt wildcard certificate)
# These are Tencent Cloud API credentials for DNS-01 challenge via DNSPod
# Get from: https://console.cloud.tencent.com/cam/capi
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=

# SMS Services (Optional)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# OSS Storage (Required)
# Available types: MINIO, AWS_S3, ALIYUN_OSS, TENCENT_COS
OSS_TYPE=TENCENT_COS
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=
OSS_REGION=ap-guangzhou
OSS_ENDPOINT=
OSS_SECURE=true

# Domain and SSL Certificate Configuration (Required)
DOMAIN=backbuy.cn
EMAIL=you@example.com

# Frontend API Base URL (Default entry)
# Use relative path /api so Next.js rewrites proxy to backend (avoids CORS)
NEXT_PUBLIC_API_URL=/api

# CORS Configuration (Required)
# Comma-separated list of allowed origins
# Production: https://backbuy.cn,https://www.backbuy.cn,https://admin.backbuy.cn,https://api.backbuy.cn
# Development: http://localhost:3000,http://localhost:3005,http://localhost:3008
CORS_ORIGINS=https://backbuy.cn,https://www.backbuy.cn,https://admin.backbuy.cn,https://api.backbuy.cn

# JD Logistics (Optional)
JD_LOGISTICS_APP_KEY=
JD_LOGISTICS_APP_SECRET=
JD_LOGISTICS_MEMBER_ID=
