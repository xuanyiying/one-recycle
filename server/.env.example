PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/one_recycle?schema=public&sslmode=disable"
REDIS_HOST=localhost
REDIS_PORT=6379
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Auth Configuration
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=15m
ACCESS_TOKEN_EXPIRES_IN_SECONDS=7200
SESSION_EXPIRES_IN_SECONDS=86400
REFRESH_TOKEN_EXPIRES_DAYS=30
CODE_EXPIRES_MINUTES=5
MAX_CODE_ATTEMPTS=3
NOTIFICATION_SERVICE_URL=http://localhost:3008
INVENTORY_SERVICE_URL=http://localhost:3008

# Social Login
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TENANT_ID=
ALIPAY_APP_ID=
ALIPAY_APP_SECRET=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
DOUYIN_APP_ID=
DOUYIN_APP_SECRET=
KUAISHOU_APP_ID=
KUAISHOU_APP_SECRET=

# Account Service
CARBON_SAVING_RATE=0.02
ACCOUNT_SERVICE_TIMEOUT=5000

# Payment Service
ALIPAY_API_URL=https://openapi.alipay.com/gateway.do
WECHAT_PAY_API_URL=https://api.mch.weixin.qq.com
PAYMENT_TIMEOUT=10000

# Payment Configuration
MOCK_PAY_URL=https://mock-pay.com/pay
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
WECHAT_PAY_GATEWAY_URL=https://api.mch.weixin.qq.com
PAYMENT_CALLBACK_URL=http://localhost:3001

# Order & Dispatch (Snowflake ID Generator)
SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_DATACENTER_ID=1

# Inventory Defaults
INVENTORY_DEFAULT_STATUS=IN_STOCK
INVENTORY_DEFAULT_ITEM_TYPE=RECYCLED
INVENTORY_DEFAULT_CONDITION=GOOD
INVENTORY_DEFAULT_PROCESSING_STATUS=RECEIVED

# Queue Configuration (Rate Limiting)
NOTIFICATION_QUEUE_LIMIT_MAX=100
NOTIFICATION_QUEUE_LIMIT_DURATION=60000

# Health Check Thresholds
HEALTH_DB_THRESHOLD_MS=1000
HEALTH_REDIS_THRESHOLD_MS=500

# Notification Service Providers (Mock Config)
SMS_API_KEY=mock-sms-key
SMS_ENDPOINT=https://sms.example.com
EMAIL_API_KEY=mock-email-key
EMAIL_ENDPOINT=https://email.example.com
PUSH_API_KEY=mock-push-key
PUSH_ENDPOINT=https://push.example.com
WEBHOOK_TIMEOUT=30000
WEBHOOK_RETRIES=3

# ============================================================================
# AI 大模型配置
# 支持多平台：OpenAI、百度文心一言、阿里通义千问、腾讯混元
# ============================================================================

# 默认使用的 AI 提供商 (openai/baidu/aliyun/tencent)
AI_DEFAULT_PROVIDER=openai

# 模型选择策略 (priority/round_robin/random/health_check)
AI_SELECTION_STRATEGY=priority

# ----------------------------------------------------------------------------
# OpenAI / 兼容 OpenAI API (如 DeepSeek)
# ----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60000

# ----------------------------------------------------------------------------
# 百度文心一言 (ERNIE)
# 文档：https://cloud.baidu.com/doc/WENXINWORKSHOP/index.html
# ----------------------------------------------------------------------------
BAIDU_API_KEY=your-baidu-api-key
BAIDU_API_SECRET=your-baidu-api-secret
BAIDU_MODEL=ernie-bot-turbo
BAIDU_TIMEOUT=30000

# ----------------------------------------------------------------------------
# 阿里通义千问 (Qwen)
# 文档：https://help.aliyun.com/document_detail/611472.html
# ----------------------------------------------------------------------------
ALIYUN_API_KEY=your-aliyun-dashscope-api-key
ALIYUN_MODEL=qwen-turbo
ALIYUN_TIMEOUT=30000

# ----------------------------------------------------------------------------
# 腾讯混元 (Hunyuan)
# 文档：https://cloud.tencent.com/document/product/1729/101843
# ----------------------------------------------------------------------------
TENCENT_API_KEY=your-tencent-secret-id
TENCENT_API_SECRET=your-tencent-secret-key
TENCENT_MODEL=hunyuan-lite
TENCENT_TIMEOUT=60000
