  @@index([userId])
  @@index([fileType])
  @@index([hashMd5])
  @@map("storages")
}

enum FileType {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  OTHER
}

enum OssType {
  MINIO
  AWS_S3
  ALIYUN_OSS
  TENCENT_COS
  LOCAL
}

/// 订单照片模型
/// 与 Storage 映射关系：
/// - photoUrl ↔ Storage.fileUrl
/// - filePath ↔ Storage.filePath（对象键，包含命名规则前缀）
/// - fileSize ↔ Storage.fileSize
/// - mimeType ↔ Storage.mimeType
/// 存储路径与命名规则（推荐）：
///   orders/{order_id}/photos/{yyyy}/{mm}/{dd}/{order_id}_{timestamp}_{random}.{ext}
/// 访问权限：
///   isPublic = false（默认私有）；如需公开展示可设为 true
model OrderPhoto {
  id           BigInt   @id @default(autoincrement()) @map("id")
  orderId      BigInt   @map("order_id")
  storageId    String   @map("storage_id")
  filename     String   @map("filename") @db.VarChar(255)
  originalName String   @map("original_name") @db.VarChar(255)
  photoUrl     String   @map("photo_url") @db.VarChar(2048)
  filePath     String   @map("file_path") @db.VarChar(512)
  fileSize     Int      @map("file_size")
  mimeType     String   @map("mime_type") @db.VarChar(100)
  hashMd5      String   @map("hash_md5") @db.VarChar(32)
  fileType     FileType @default(IMAGE) @map("file_type")
  category     String?  @map("category") @db.VarChar(50)
  thumbnailUrl String?  @map("thumbnail_url") @db.VarChar(2048)
  ossType      OssType  @map("oss_type")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")
  created_at   DateTime @default(now()) @map("created_at")
  updated_at   DateTime @updatedAt @map("updated_at")

  order   Order   @relation(fields: [orderId], references: [id])
  storage Storage @relation(fields: [storageId], references: [id])

  @@unique([orderId, filePath]) // 防止同一订单重复对象键
  // 性能与约束：高并发检索与去重
  @@index([orderId])
  @@index([storageId])
  @@index([uploadedAt])
  @@map("order_photos")
}

