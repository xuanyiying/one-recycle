model Account {
  id               BigInt        @id @default(autoincrement()) @map("id")
  userId           BigInt        @map("user_id")
  availableBalance Decimal       @default(0) @map("available_balance") @db.Decimal(12, 2) // 可用余额
  frozenBalance    Decimal       @default(0) @map("frozen_balance") @db.Decimal(12, 2) // 冻结余额
  totalIncome      Decimal       @default(0) @map("total_income") @db.Decimal(12, 2) // 收益总额
  totalWithdrawal  Decimal       @default(0) @map("total_withdrawal") @db.Decimal(12, 2) // 提现总额
  version          Int           @default(0) @map("version") // 版本号，用于乐观锁
  accountType      AccountType   @default(WALLET) @map("account_type")
  accountDetails   Json          @map("account_details") // 存储账户信息的JSON
  isVerified       Boolean       @default(false) @map("is_verified") // 是否已验证
  paymentPassword  String?       @map("payment_password") @db.VarChar(255) // 支付密码
  createdAt        DateTime      @default(now()) @map("created_at") // 创建时间
  updatedAt        DateTime      @updatedAt @map("updated_at") // 更新时间
  user             User          @relation(fields: [userId], references: [id])
  transactions     Transaction[]
  withdrawals      Withdrawal[]

  @@unique([userId, accountType])
  @@index([userId])
  @@index([accountType])
  @@map("accounts")
}

enum AccountType {
  WALLET
  PAYOUT
}

// 提现记录
model Withdrawal {
  id             BigInt           @id @default(autoincrement()) @map("id")
  accountId      BigInt           @map("account_id")
  userId         BigInt           @map("user_id")
  amount         Decimal          @map("amount") @db.Decimal(10, 2)
  provider       PaymentProvider  @map("provider")
  outTradeNo     String           @unique @map("out_trade_no") @db.VarChar(128)
  idempotencyKey String?          @unique @map("idempotency_key") @db.VarChar(64)
  transactionId  BigInt?          @map("transaction_id")
  status         WithdrawalStatus @default(PENDING) @map("status")
  accountInfo    Json             @map("account_info") // 提现账户信息
  adminId        BigInt?          @map("admin_id")
  processedAt    DateTime?        @map("processed_at")
  rejectedReason String?          @map("rejected_reason") @db.VarChar(255)
  callbackData   Json?            @map("callback_data")
  version        Int              @default(0) @map("version")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  account        Account          @relation(fields: [accountId], references: [id])
  transactions   Transaction[]
  user           User             @relation(fields: [userId], references: [id])

  @@index([accountId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("withdrawals")
}

// 交易记录
model Transaction {
  id            BigInt          @id @default(autoincrement()) @map("id")
  accountId     BigInt          @map("account_id")
  type          TransactionType @map("type")
  amount        Decimal         @map("amount") @db.Decimal(10, 2)
  balanceBefore Decimal         @map("balance_before") @db.Decimal(10, 2)
  balanceAfter  Decimal         @map("balance_after") @db.Decimal(10, 2)
  orderId       String?         @map("order_id") @db.VarChar(64)
  withdrawalId  BigInt?         @map("withdrawal_id")
  description   String          @map("description") @db.VarChar(255)
  createdAt     DateTime        @default(now()) @map("created_at")
  account       Account         @relation(fields: [accountId], references: [id])
  withdrawal    Withdrawal?     @relation(fields: [withdrawalId], references: [id])

  @@unique([type, orderId])
  @@unique([type, withdrawalId])
  @@index([accountId])
  @@index([orderId])
  @@index([withdrawalId])
  @@index([createdAt])
  @@index([type])
  @@index([accountId, type])
  @@index([accountId, createdAt])
  @@map("transactions")
}

enum TransactionType {
  ORDER_INCOME // 订单收入
  WITHDRAWAL_FREEZE // 提现冻结
  WITHDRAWAL_SUCCESS // 提现成功
  WITHDRAWAL_FAILED // 提现失败
  WITHDRAWAL_REJECTED // 提现拒绝
  REFUND // 退款
  ADJUSTMENT // 人工调整
}

enum WithdrawalStatus {
  PENDING // 待处理
  PROCESSING // 处理中
  SUCCESS // 成功
  FAILED // 失败
  REJECTED // 已拒绝
  TIMEOUT // 超时
}

