  inviteeId         BigInt   @map("invitee_id")
  rewardPoints      Int      @default(0) @map("reward_points")
  totalOrderRewards Int      @default(0) @map("total_order_rewards") // 订单返佣总积分
  totalOrders       Int      @default(0) @map("total_orders") // 被邀请者下单数量
  totalItems        Int      @default(0) @map("total_items") // 被邀请者卖出旧物总数量
  createdAt         DateTime @default(now()) @map("created_at")

  inviter         User             @relation("UserInvites", fields: [inviterId], references: [id])
  invitee         User             @relation("UserInvitedBy", fields: [inviteeId], references: [id])
  referralRewards ReferralReward[]

  @@unique([inviteeId])
  @@index([inviterId])
  @@map("invite_records")
}

/// 返佣记录表
model ReferralReward {
  id             BigInt               @id @default(autoincrement())
  inviteRecordId BigInt               @map("invite_record_id")
  orderId        BigInt               @map("order_id")
  inviterId      BigInt               @map("inviter_id")
  inviteeId      BigInt               @map("invitee_id")
  rewardPoints   Int                  @map("reward_points")
  orderAmount    Decimal              @map("order_amount") @db.Decimal(12, 2)
  rewardType     String               @map("reward_type") @db.VarChar(20) // FIXED, PERCENTAGE
  rewardValue    Decimal              @map("reward_value") @db.Decimal(12, 2) // 固定金额或比例值
  status         ReferralRewardStatus @default(PENDING) @map("status")
  createdAt      DateTime             @default(now()) @map("created_at")

  inviteRecord InviteRecord @relation(fields: [inviteRecordId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id])

  @@unique([orderId])
  @@index([inviterId])
  @@index([inviteeId])
  @@index([inviteRecordId])
  @@map("referral_rewards")
}

// ============================================
// Content Configuration Module - 内容配置模块
// ============================================

/// FAQ分类枚举
enum FAQCategory {
  SERVICE // 服务相关
  PAYMENT // 支付相关
  CATEGORY // 物品分类
  POINTS // 积分相关
  ACCOUNT // 账户相关
  GENERAL // 通用问题
}

/// 常见问答表
model FAQ {
  id        BigInt      @id @default(autoincrement())
  question  String      @map("question") @db.Text
  answer    String      @map("answer") @db.Text
  category  FAQCategory @default(GENERAL) @map("category")
  sortOrder Int         @default(0) @map("sort_order")
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([category])
  @@index([isActive, sortOrder])
  @@map("faqs")
}

/// 回收规则分类枚举
enum RecycleRuleCategory {
  SERVICE_TYPE // 服务类型
  SERVICE_SCOPE // 服务范围
  PROCESS // 操作流程
  STANDARD // 回收标准
  POINTS_RULE // 积分规则
  NOTICE // 注意事项
}

/// 回收规则表
model RecycleRule {
  id        BigInt              @id @default(autoincrement())
  category  RecycleRuleCategory @default(SERVICE_TYPE) @map("category")
  title     String              @map("title") @db.VarChar(100)
  content   String              @map("content") @db.Text
  icon      String?             @map("icon") @db.VarChar(50)
  sortOrder Int                 @default(0) @map("sort_order")
  isActive  Boolean             @default(true) @map("is_active")
  extra     Json?               @map("extra") // 扩展字段，用于存储标签列表等
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@index([category])
  @@index([isActive, sortOrder])
  @@map("recycle_rules")
}

/// 分类仓库配置表 - 根据商品分类自动分配目标仓库
model CategoryWarehouseConfig {
  id          BigInt   @id @default(autoincrement()) @map("id")
  categoryId  Int      @unique @map("category_id")
  warehouseId BigInt   @map("warehouse_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@index([isActive])
  @@map("category_warehouse_configs")
}
