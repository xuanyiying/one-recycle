generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// 系统配置表
model SystemConfig {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

/// 平台信息表
model Platform {
  id          Int          @id @default(autoincrement())
  name        String // 微信、支付宝、抖音、快手等
  code        String       @unique // wx, alipay, douyin, kuaishou
  appId       String       @map("app_id")
  appSecret   String       @map("app_secret")
  isActive    Boolean      @default(true) @map("is_active")
  config      Json? // 平台特定配置
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  appVersions AppVersion[]

  @@map("platforms")
}

/// 客户端版本管理
model AppVersion {
  id          Int      @id @default(autoincrement())
  platformId  Int      @map("platform_id")
  version     String
  buildNumber Int      @map("build_number")
  url         String
  forceUpdate Boolean  @default(false) @map("force_update")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  platform    Platform @relation(fields: [platformId], references: [id])

  @@index([platformId])
  @@map("app_versions")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  type        String   @default("PRODUCT")
  parentId    Int?     @map("parent_id")
  icon        String?
  priceInfo   String   @map("price_info")
  seo         String
  sortOrder   Int      @default(0) @map("sort_order")
  isVisible   Boolean  @default(true) @map("is_visible")
  isFeatured  Boolean  @default(false) @map("is_featured")
  attributes  String?
  level       Int      @default(0)
  path        String   @default("0")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // 自引用关系
  parent              Category?                @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children            Category[]               @relation("CategoryHierarchy")
  inventoryItems      InventoryItem[]
  orderItems          OrderItem[]
  recyclePricingRules RecyclePricingRule[]
  warehouseConfig     CategoryWarehouseConfig?

  @@index([type])
  @@index([parentId])
  @@map("categories")
}

/// 用户主表
model User {
  id                 BigInt              @id @default(autoincrement())
  mobile             String?             @unique @db.VarChar(20)
  email              String?             @unique @db.VarChar(100)
  nickname           String?             @db.VarChar(50)
  realName           String?             @map("real_name") @db.VarChar(50)
  avatarUrl          String?             @map("avatar_url") @db.VarChar(255)
  gender             String? // male, female, other
  birthday           DateTime?
  status             UserStatus          @default(ACTIVE)
  level              Int                 @default(0) // 用户等级
  points             Int                 @default(0) @map("points") // 积分
  balance            Decimal             @default(0) @map("balance") @db.Decimal(12, 2) // 余额
  lastLogin          DateTime?           @map("last_login")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  identities         UserIdentity[]
  addresses          Address[]
  orders             Order[]
  favorites          UserFavorite[]
  feedbacks          UserFeedback[]
  courierFeedbacks   CourierFeedback[]
  orderFeedback      OrderFeedback[]
  withdrawals        Withdrawal[]
  accounts           Account[]
  chatSessions       ChatSession[]
  serviceTickets     ServiceTicket[]
  aiConversationLogs AIConversationLog[]
  voiceOrderSessions VoiceOrderSession[]
  pointsRecords      PointsRecord[]
  pointsOrders       PointsOrder[]
  signInRecords      SignInRecord[]
  taskRecords        TaskRecord[]
  invites            InviteRecord[]      @relation("UserInvites")
  invitedBy          InviteRecord?       @relation("UserInvitedBy")

  @@index([mobile])
  @@index([email])
  @@index([status])
  @@map("users")
}

/// 用户地址表
model Address {
  id           BigInt        @id @default(autoincrement()) @map("id")
  userId       BigInt        @map("user_id")
  name         String        @map("name") @db.VarChar(50) // 收货人
  mobile       String        @map("mobile") @db.VarChar(20) // 手机号
  province     String        @map("province") @db.VarChar(50) // 省
  city         String        @map("city") @db.VarChar(50) // 市
  district     String        @map("district") @db.VarChar(50) // 县 / 区
  town         String        @map("town") @db.VarChar(50) // 乡镇 /街道办
  street       String        @map("street") @db.VarChar(50) // 街道
  zipCode      String        @map("zip_code") @db.VarChar(10) // 邮编
  detail       String        @map("detail") @db.VarChar(255) // 详细地址
  isDefault    Boolean       @default(false) @map("is_default")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  user         User          @relation(fields: [userId], references: [id])
  orders       Order[]
  pointsOrders PointsOrder[]

  @@index([userId])
  @@map("addresses")
}

/// 用户多平台身份
model UserIdentity {
  id           BigInt   @id @default(autoincrement()) @map("id")
  userId       BigInt   @map("user_id")
  provider     String   @map("provider") @db.VarChar(20) // 'wechat', 'alipay', 'douyin', 'kuaishou'
  appId        String   @map("app_id") @db.VarChar(100) // 平台应用ID
  openid       String   @map("openid") @db.VarChar(100)
  unionid      String?  @map("unionid") @db.VarChar(100)
  sessionKey   String?  @map("session_key") @db.VarChar(100)
  accessToken  String?  @map("access_token")
  refreshToken String?  @map("refresh_token")
  expiresIn    Int?     @map("expires_in")
  scope        String?  @map("scope") @db.VarChar(200)
  extraData    Json?    @map("extra_data")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id])

  @@unique([provider, openid])
  @@index([userId])
  @@index([unionid])
  @@map("user_identities")
}

enum UserStatus {
  ACTIVE // 正常
  SUSPENDED // 禁用
  DELETED // 删除
}

enum OrderStatus {
  PENDING // 待处理
  PENDING_PICKUP // 待取件
  PICKED_UP // 已取件
  IN_TRANSIT // 运输中
  PENDING_RECEIPT // 待收货
  INSPECTING // 验货中
  INSPECTED // 已验货
  INSPECTION_EXCEPTION // 验货异常
  MANUAL_PROCESSING // 人工处理
  PENDING_INBOUND // 待入库
  INBOUNDED // 已入库
  PENDING_SETTLEMENT // 待结算
  COMPLETED // 已完成
  REFUNDED // 已退款
  CANCELLED // 已取消
}

/// 订单表
model Order {
  id                 BigInt                 @id @default(autoincrement()) @map("id")
  orderNo            String                 @unique @map("order_no")
  userId             BigInt                 @map("user_id")
  addressId          BigInt                 @map("address_id")
  orderType          String                 @default("RECYCLE") @map("order_type")
  status             OrderStatus            @default(PENDING) @map("status")
  priority           Int                    @default(0) @map("priority")
  expectPickupTime   DateTime?              @map("expect_pickup_time")
  actualPickupTime   DateTime?              @map("actual_pickup_time")
  expectDeliveryTime DateTime?              @map("expect_delivery_time")
  actualDeliveryTime DateTime?              @map("actual_delivery_time")
  estimatedAmount    Decimal                @map("estimated_amount") @db.Decimal(12, 2)
  settlementAmount   Decimal                @map("settlement_amount") @db.Decimal(12, 2)
  payAmount          Decimal                @map("pay_amount") @db.Decimal(12, 2)
  discountAmount     Decimal                @default(0) @map("discount_amount") @db.Decimal(12, 2)
  couponId           String?                @map("coupon_id")
  channel            String                 @map("channel")
  remark             String?                @map("remark")
  source             String?                @map("source") // 来源平台
  sourceAppVersion   String?                @map("source_app_version")
  longitude          Float?                 @map("longitude") // 经度
  latitude           Float?                 @map("latitude") // 纬度
  cancelReason       String?                @map("cancel_reason")
  cancelAt           DateTime?              @map("cancel_at")
  closedAt           DateTime?              @map("closed_at")
  completedAt        DateTime?              @map("completed_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  user               User                   @relation(fields: [userId], references: [id])
  address            Address                @relation(fields: [addressId], references: [id])
  items              OrderItem[]
  assignments        OrderAssignment[]
  payments           Payment[]
  reservations       Reservation[]
  payment_logs       PaymentLog[]
  feedback           OrderFeedback?
  timeline           OrderTimeline[]
  userFeedbacks      UserFeedback[]
  courierFeedbacks   CourierFeedback[]
  logisticsOrder     LogisticsOrder? // 物流单
  logisticsApiCalls  LogisticsApiCall[]
  logisticsCallbacks LogisticsCallbackLog[]
  photos             OrderPhoto[] // 订单照片（与存储关联）
  tenant             Tenant?                @relation(fields: [tenantId], references: [id])
  tenantId           BigInt?                @map("tenant_id")
  settlementRecord   SettlementRecord?
  inboundReceipt     InboundReceipt?
  serviceTickets     ServiceTicket[]
  referralReward     ReferralReward?
  targetWarehouseId  BigInt?                @map("target_warehouse_id")
  targetWarehouse    Warehouse?             @relation("OrderTargetWarehouse", fields: [targetWarehouseId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([orderType])
  @@index([channel])
  @@index([createdAt])
  @@index([targetWarehouseId])
  @@map("orders")
}

enum LogisticsStatus {
  CREATED
  ORDERED
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
  FAILED
}

enum LogisticsApiAction {
  PRECHECK
  CREATE_ORDER
  SUBSCRIBE_TRACE
  QUERY_TRACE
  CANCEL_ORDER
}

/// 物流订单表
model LogisticsOrder {
  id               BigInt          @id @default(autoincrement()) @map("id")
  orderId          BigInt          @map("order_id")
  logisticsNo      String?         @unique @map("logistics_no") // 物流运单号
  logisticsCompany String?         @map("logistics_company") // 物流公司编码 (JD, SF, etc.)
  status           LogisticsStatus @default(CREATED) @map("status") // 物流状态
  providerStatus   String?         @map("provider_status") @db.VarChar(50)

  // 寄件人快照
  senderName    String? @map("sender_name")
  senderPhone   String? @map("sender_phone")
  senderAddress String? @map("sender_address")

  // 收件人快照
  receiverName    String? @map("receiver_name")
  receiverPhone   String? @map("receiver_phone")
  receiverAddress String? @map("receiver_address")

  // 时间信息
  estimatedPickupTime   DateTime? @map("estimated_pickup_time")
  actualPickupTime      DateTime? @map("actual_pickup_time")
  estimatedDeliveryTime DateTime? @map("estimated_delivery_time")
  actualDeliveryTime    DateTime? @map("actual_delivery_time")

  // 费用
  deliveryFee Decimal? @map("delivery_fee") @db.Decimal(12, 2)

  // 完整响应快照
  providerData Json? @map("provider_data")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order        Order                  @relation(fields: [orderId], references: [id])
  apiCalls     LogisticsApiCall[]
  callbackLogs LogisticsCallbackLog[]

  @@unique([orderId])
  @@index([orderId])
  @@map("logistics_orders")
}

model LogisticsApiCall {
  id               BigInt             @id @default(autoincrement()) @map("id")
  logisticsOrderId BigInt?            @map("logistics_order_id")
  orderId          BigInt             @map("order_id")
  providerCode     String             @map("provider_code") @db.VarChar(20)
  action           LogisticsApiAction @map("action")
  idempotencyKey   String?            @unique @map("idempotency_key") @db.VarChar(64)
  requestPayload   Json?              @map("request_payload")
  responsePayload  Json?              @map("response_payload")
  httpStatus       Int?               @map("http_status")
  durationMs       Int?               @map("duration_ms")
  success          Boolean            @default(false) @map("success")
  errorCode        String?            @map("error_code") @db.VarChar(50)
  errorMessage     String?            @map("error_message") @db.VarChar(255)
  retryCount       Int                @default(0) @map("retry_count")
  createdAt        DateTime           @default(now()) @map("created_at")

  order          Order           @relation(fields: [orderId], references: [id])
  logisticsOrder LogisticsOrder? @relation(fields: [logisticsOrderId], references: [id])

  @@index([orderId, providerCode, action])
  @@index([logisticsOrderId])
  @@index([createdAt])
  @@map("logistics_api_calls")
}

model LogisticsCallbackLog {
  id               BigInt    @id @default(autoincrement()) @map("id")
  logisticsOrderId BigInt?   @map("logistics_order_id")
  orderId          BigInt?   @map("order_id")
  providerCode     String    @map("provider_code") @db.VarChar(20)
  headers          Json?     @map("headers")
  rawBody          String    @map("raw_body")
  parsedBody       Json?     @map("parsed_body")
  signatureValid   Boolean?  @map("signature_valid")
  processed        Boolean   @default(false) @map("processed")
  processedAt      DateTime? @map("processed_at")
  processError     String?   @map("process_error") @db.VarChar(255)
  receivedAt       DateTime  @default(now()) @map("received_at")

  order          Order?          @relation(fields: [orderId], references: [id])
  logisticsOrder LogisticsOrder? @relation(fields: [logisticsOrderId], references: [id])

  @@index([providerCode, receivedAt])
  @@index([orderId])
  @@index([logisticsOrderId])
  @@map("logistics_callback_logs")
}

/// 订单分配表
model OrderAssignment {
  id                BigInt     @id @default(autoincrement()) @map("id")
  orderId           BigInt     @map("order_id")
  courierId         String     @map("courier_id")
  taskId            String?    @map("task_id")
  orderNo           String     @map("order_no")
  waybillNo         String?    @map("waybill_no")
  pickupCode        String?    @map("pickup_code")
  status            TaskStatus @map("status")
  assignedAt        DateTime   @default(now()) @map("assigned_at")
  acceptedAt        DateTime?  @map("accepted_at")
  startedAt         DateTime?  @map("started_at")
  arrivedAt         DateTime?  @map("arrived_at")
  completedAt       DateTime?  @map("completed_at")
  cancelledAt       DateTime?  @map("cancelled_at")
  failedAt          DateTime?  @map("failed_at")
  notes             String?    @map("notes")
  estimatedDuration Int?       @map("estimated_duration")
  actualDuration    Int?       @map("actual_duration")
  pickupLocation    Json?      @map("pickup_location")
  deliveryLocation  Json?      @map("delivery_location")
  createdAt         DateTime   @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id])
  courier Courier @relation(fields: [courierId], references: [id])

  @@index([courierId])
  @@index([orderId])
  @@map("order_assignments")
}

/// 订单项表
model OrderItem {
  id              BigInt   @id @default(autoincrement()) @map("id")
  orderId         BigInt   @map("order_id")
  categoryId      Int      @map("category_id")
  estimatedWeight Float    @map("estimated_weight")
  actualWeight    Float?   @map("actual_weight")
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 2)
  amount          Decimal  @map("amount") @db.Decimal(12, 2)
  quantity        Int      @default(1) @map("quantity")
  condition       String?  @map("condition") @db.VarChar(50)
  photos          Json?    @map("photos")
  brandModel      String?  @map("brand_model") @db.VarChar(100)
  notes           String?  @map("notes") @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at")
  order           Order    @relation(fields: [orderId], references: [id])
  category        Category @relation(fields: [categoryId], references: [id])

  @@index([orderId])
  @@index([categoryId])
  @@map("order_items")
}

/// 支付表
model Payment {
  id            BigInt          @id @default(autoincrement()) @map("id")
  orderId       BigInt          @map("order_id")
  transactionId BigInt          @unique @map("transaction_id")
  outTradeNo    String          @unique @map("out_trade_no")
  total         Decimal         @map("total") @db.Decimal(12, 2)
  status        PaymentStatus   @map("status")
  provider      PaymentProvider @map("provider")
  notifyRaw     String?         @map("notify_raw")
  paidAt        DateTime?       @map("paid_at")
  closedAt      DateTime?       @map("closed_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  order         Order           @relation(fields: [orderId], references: [id])
  refunds       Refund[]
  logs          PaymentLog[]

  @@index([orderId])
  @@index([transactionId])
  @@index([outTradeNo])
  @@index([status])
  @@index([provider])
  @@map("payments")
}

/// 支付日志表
model PaymentLog {
  id            BigInt          @id @default(autoincrement()) @map("id")
  transactionId BigInt          @map("transaction_id")
  orderId       BigInt          @map("order_id")
  amount        Decimal         @map("amount") @db.Decimal(12, 2)
  status        PaymentStatus   @map("status")
  provider      PaymentProvider @map("provider")
  rawData       String?         @map("raw_data")
  processedAt   DateTime?       @map("processed_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  order         Order?          @relation(fields: [orderId], references: [id])
  payment       Payment?        @relation(fields: [transactionId], references: [transactionId])

  @@index([transactionId])
  @@index([orderId])
  @@map("payment_logs")
}

/// 地区数据表
model Region {
  id         Int      @id @default(autoincrement()) @map("id")
  code       String   @unique @map("code") @db.VarChar(12) // 行政区划代码
  name       String   @map("name") @db.VarChar(100) // 名称
  level      Int      @map("level") // 层级: 1-省, 2-市, 3-区, 4-街道
  parentCode String?  @map("parent_code") @db.VarChar(12) // 父级代码
  pinyin     String?  @map("pinyin") @db.VarChar(100) // 拼音
  abbr       String?  @map("abbr") @db.VarChar(50) // 简称/缩写
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([parentCode])
  @@index([level])
  @@map("regions")
}

/// 退款表
model Refund {
  id           BigInt       @id @default(autoincrement()) @map("id")
  paymentId    BigInt       @map("payment_id")
  outRefundNo  String       @unique @map("out_refund_no")
  refundAmount Decimal      @map("refund_amount") @db.Decimal(12, 2)
  status       RefundStatus @map("status")
  reason       String?      @map("reason")
  notifyRaw    String?      @map("notify_raw")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  payment      Payment      @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([outRefundNo])
  @@map("refunds")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum RefundStatus {
  PROCESSING
  SUCCESS
  FAILED
}

enum PaymentProvider {
  WECHAT
  ALIPAY
  UNIONPAY
  BALANCE
}

/// 通知表
model Notification {
  id              BigInt               @id @map("id")
  type            NotificationType     @map("type")
  status          NotificationStatus   @map("status")
  priority        NotificationPriority @map("priority")
  recipient       Json                 @map("recipient")
  content         String               @map("content")
  deliveryOptions Json?                @map("delivery_options")
  sentAt          DateTime?            @map("sent_at")
  deliveredAt     DateTime?            @map("delivered_at")
  failedAt        DateTime?            @map("failed_at")
  result          Json?                @map("result")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@index([status])
  @@index([type])
  @@map("notifications")
}

/// 通知模板表
model NotificationTemplate {
  id        BigInt       @id @map("id")
  name      String       @map("name")
  type      TemplateType @map("type")
  subject   String?      @map("subject")
  content   String       @map("content")
  variables String[]     @map("variables")
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("notification_templates")
}

/// 通知批次表
model NotificationBatch {
  id             BigInt    @id @map("id")
  name           String    @map("name")
  description    String?   @map("description")
  totalCount     Int       @map("total_count")
  sentCount      Int       @map("sent_count")
  deliveredCount Int       @map("delivered_count")
  failedCount    Int       @map("failed_count")
  status         String    @map("status")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("notification_batches")
}

enum NotificationType {
  SMS
  EMAIL
  PUSH
  IN_APP
  WEBHOOK
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TemplateType {
  ORDER_CONFIRMATION
  PAYMENT_SUCCESS
  DELIVERY_UPDATE
  SYSTEM_ALERT
  CUSTOM
}

/// 库存项目表
model InventoryItem {
  id               BigInt                 @id @default(autoincrement()) @map("id")
  warehouseId      BigInt                 @map("warehouse_id")
  categoryId       Int                    @map("category_id")
  name             String                 @map("name")
  description      String?                @map("description")
  unit             String                 @map("unit")
  quantity         Float                  @map("quantity")
  reservedQty      Float                  @default(0) @map("reserved_qty")
  availableQty     Float                  @map("available_qty")
  unitPrice        Float                  @map("unit_price")
  totalPrice       Float                  @map("total_price")
  location         String?                @map("location")
  status           InventoryStatus        @map("status")
  itemType         ItemType               @map("item_type")
  condition        ItemCondition          @map("condition")
  sourceOrderId    BigInt?                @map("source_order_id")
  qualityGrade     String?                @map("quality_grade")
  processingStatus ProcessingStatus       @map("processing_status")
  expiryDate       DateTime?              @map("expiry_date")
  batchNumber      String?                @map("batch_number")
  minStockLevel    Float?                 @map("min_stock_level")
  maxStockLevel    Float?                 @map("max_stock_level")
  weight           Float?                 @map("weight") // 物品重量
  volume           Float?                 @map("volume") // 物品体积
  brand            String?                @map("brand") // 品牌
  model            String?                @map("model") // 型号
  images           String[]               @map("images") // 图片URL列表
  tags             String[]               @map("tags") // 标签
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  warehouse        Warehouse              @relation(fields: [warehouseId], references: [id])
  category         Category               @relation(fields: [categoryId], references: [id])
  transactions     InventoryTransaction[]
  reservations     Reservation[]
