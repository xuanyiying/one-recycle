/// 客服工单表
model ServiceTicket {
  id          BigInt         @id @default(autoincrement()) @map("id")
  ticketNo    String         @unique @map("ticket_no") @db.VarChar(32)
  sessionId   BigInt?        @map("session_id")
  userId      BigInt         @map("user_id")
  orderId     BigInt?        @map("order_id")
  type        TicketType     @map("type")
  priority    TicketPriority @default(NORMAL) @map("priority")
  status      TicketStatus   @default(PENDING) @map("status")
  title       String         @map("title") @db.VarChar(200)
  description String?        @map("description") @db.Text
  attachments String[]       @map("attachments")
  assignedTo  BigInt?        @map("assigned_to")
  resolution  String?        @map("resolution") @db.Text
  resolvedAt  DateTime?      @map("resolved_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  closedAt    DateTime?      @map("closed_at")

  session   ChatSession?    @relation(fields: [sessionId], references: [id])
  user      User            @relation(fields: [userId], references: [id])
  order     Order?          @relation(fields: [orderId], references: [id])
  assignee  Staff?          @relation("StaffToServiceTicket", fields: [assignedTo], references: [id])
  histories TicketHistory[]

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([type])
  @@index([assignedTo])
  @@index([createdAt])
  @@map("service_tickets")
}

/// 工单处理记录表
model TicketHistory {
  id         BigInt        @id @default(autoincrement()) @map("id")
  ticketId   BigInt        @map("ticket_id")
  operatorId BigInt?       @map("operator_id")
  action     TicketAction  @map("action") // CREATE, ASSIGN, UPDATE, RESOLVE, CLOSE, REOPEN
  fromStatus TicketStatus? @map("from_status")
  toStatus   TicketStatus? @map("to_status")
  comment    String?       @map("comment") @db.Text
  createdAt  DateTime      @default(now()) @map("created_at")

  ticket   ServiceTicket @relation(fields: [ticketId], references: [id])
  operator Staff?        @relation(fields: [operatorId], references: [id])

  @@index([ticketId])
  @@index([createdAt])
  @@map("ticket_histories")
}

/// 快捷回复表
