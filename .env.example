# OneRecycle Environment Variables

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/account_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Message Queue
QUEUE_REMOVE_ON_COMPLETE=100
QUEUE_REMOVE_ON_FAIL=1000

# Bull Board
BULL_BOARD_ENABLED=true
BULL_BOARD_PATH=/admin/queues

# Services
API_GATEWAY_PORT=3002
ACCOUNT_SERVICE_PORT=3001
ORDER_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004
COURIER_SERVICE_PORT=3005
DISPATCH_SERVICE_PORT=3006
CATEGORY_SERVICE_PORT=3008
INVENTORY_SERVICE_PORT=3009
MESSAGE_QUEUE_PORT=3010

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Third Party APIs
JD_EXPRESS_API_KEY=your-jd-express-api-key
JD_EXPRESS_API_URL=https://api.jd-express.com

# AI Providers Configuration
# OpenAI (also supports compatible APIs like DeepSeek, Azure OpenAI)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60000

# Aliyun Qwen (通义千问)
ALIYUN_API_KEY=your-aliyun-api-key
ALIYUN_MODEL=qwen-turbo
ALIYUN_TIMEOUT=30000

# Baidu Wenxin (文心一言)
BAIDU_API_KEY=your-baidu-api-key
BAIDU_API_SECRET=your-baidu-api-secret
BAIDU_MODEL=ernie-bot-turbo
BAIDU_TIMEOUT=30000

# Tencent Hunyuan (混元)
TENCENT_API_KEY=your-tencent-api-key
TENCENT_API_SECRET=your-tencent-api-secret
TENCENT_MODEL=hunyuan-lite
TENCENT_TIMEOUT=30000

# Ollama (本地部署)
OLLAMA_API_KEY=not-needed
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=60000

# SiliconCloud
SILICONCLOUD_API_KEY=your-siliconcloud-api-key
SILICONCLOUD_BASE_URL=https://api.siliconflow.cn/v1
SILICONCLOUD_MODEL=deepseek-ai/DeepSeek-V3
SILICONCLOUD_TIMEOUT=60000

# OpenRouter (聚合平台 - 支持多种免费模型)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_TIMEOUT=60000
# OpenRouter 特殊配置（免费模型必需）
OPENROUTER_SITE_URL=https://github.com/one-recycle
OPENROUTER_SITE_NAME=OneRecycle

# AI Service Configuration
AI_DEFAULT_PROVIDER=openrouter
AI_SELECTION_STRATEGY=priority